# Leave DATABASE_URL unset for a persistent local demo in data/knockout.json.
# DATABASE_URL=postgresql://knockout:knockout_dev@localhost:55432/knockout
PORT=3000
HOST=127.0.0.1
# Required in production and for authenticator encryption. Keep this stable.
# SESSION_SECRET=
PUBLIC_ORIGIN=http://localhost:5173
# Production registration and password recovery require email delivery.
# MAIL_FROM is required, plus one provider. Resend is used when RESEND_API_KEY
# is set; otherwise SMTP_URL. The sender domain must be verified in Resend.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# SMTP_URL=smtps://user:password@mail.example.com:465
# MAIL_FROM=Knockout <no-reply@example.com>
# Set to true while you cannot email everyone (for example Resend without a
# verified domain). Registration then succeeds even if the email fails, and an
# administrator verifies accounts under Account management. Remove it once
# email delivery works for all users.
# MANUAL_VERIFICATION=true
